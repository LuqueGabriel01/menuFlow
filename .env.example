# Copy this file to .env and fill in real values for your machine.
# .env is git-ignored on purpose: it is the only place secrets should live.
# application.properties only ever references these as ${VAR_NAME}.

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Database (app datasource) ---
MENU_FLOW_DATASOURCE_URL=jdbc:mysql://localhost:3307/restaurant_db
MENU_FLOW_DATASOURCE_USERNAME=root
MENU_FLOW_DATASOURCE_PASSWORD=change-me

# --- JPA / Hibernate ---
# Use 'update' while developing locally, 'validate' in production.
MENU_FLOW_JPA_DDL=update
MENU_FLOW_JPA_SHOW_SQL=true

# --- Security ---
# Generate a long, random secret for production (e.g. openssl rand -base64 48).
MENU_FLOW_JWT_SECRET=change-me-to-a-long-random-secret
MENU_FLOW_JWT_EXPIRATION=1800000
MENU_FLOW_INTERNAL_API_KEY=change-me

# --- Logging ---
MENU_FLOW_LOG_LEVEL_ROOT=INFO
MENU_FLOW_LOG_LEVEL_SPRING=WARN

# --- Swagger / OpenAPI ---
SWAGGER_UI_DOCUMENTATION_ENABLED=true

# --- Misc ---
MENU_FLOW_FRONTEND_URL=http://localhost:4200
MENU_FLOW_QR_SIZE=300

# --- MySQL container (used by docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=restaurant_db
MYSQL_USER=change-me
MYSQL_PASSWORD=change-me
DB_PORT_EXTERNAL=3307
